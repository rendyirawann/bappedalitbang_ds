# yii console commands
/yii
/yii_test
/yii_test.bat

# phpstorm project files
.idea

# netbeans project files
nbproject

# zend studio for eclipse project files
.buildpath
.project
.settings

# windows thumbnail cache
Thumbs.db

# composer vendor dir
/vendor

# composer itself is not needed
composer.phar

# Mac DS_Store Files
.DS_Store

# phpunit itself is not needed
phpunit.phar
# local phpunit config
/phpunit.xml

# vagrant runtime
/.vagrant

# ignore generated files
/frontend/web/index.php
/frontend/web/index-test.php
/frontend/web/robots.txt
/backend/web/index.php
/backend/web/index-test.php
/backend/web/robots.txt

# ============================================================
# Tambahan 2026-09-04 - persiapan push ke bappedalitbang_ds
# Tanpa ini repo berukuran 3,3 GB dan ditolak GitHub.
# ============================================================

# --- Berkas sementara hasil runtime aplikasi ---
/frontend/runtime/
/backend/runtime/
/console/runtime/
/common/runtime/
*.log

# --- Aset yang digenerate ulang otomatis oleh Yii ---
/frontend/web/assets/
/backend/web/assets/

# --- Unggahan pengguna (1,6 GB, bukan bagian dari kode) ---
/frontend/web/uploads/
/backend/web/uploads/

# --- Sub-aplikasi terpisah, tidak ikut ke repo ini ---
# bidang-idk punya folder .git sendiri (remote ke esakip.git).
# Kalau ikut di-commit, git akan memperlakukannya sebagai
# submodule yang rusak. Riwayatnya dibiarkan utuh di server.
/bidang-idk/

# idkapp adalah aplikasi terpisah; hanya dependensinya
# yang dikecualikan agar tidak ikut membengkakkan repo.
/idkapp/vendor/
/idkapp/*/runtime/
/idkapp/*/web/assets/
/idkapp/*/web/uploads/
# dokumen unggahan pengguna di idkapp (data, bukan kode)
/idkapp/*/web/dokumen/

# --- Konfigurasi lokal: berisi kata sandi database asli ---
*-local.php

# --- Dependensi front-end ---
node_modules/

# --- Editor ---
*.swp
*.swo
.env


# dump database lokal (berisi data pegawai) - jangan di-commit
/*.sql

# gambar kerja lokal (Standar Pelayanan, SKM)
/SP*.png
/skm*.jpeg
